# Copy to .env and fill in. .env is ignored by git; only this example is versioned.
#   cp .env.example .env

# --- skail ----------------------------------------------------------------------------------------
# Values of your environment in the skail portal.
#
# name:version of the workload, exactly as registered in the portal. If it does not match,
# the worker starts but never receives a run.
SKAIL_WORKLOAD=batchbilling:v1.0.0
# Namespace (tenant/environment) and key of the environment. The key is a secret: keep it only in .env.
SKAIL_NAMESPACE=<tenant>/<environment>
SKAIL_KEY=<environment-key>
# Address of skail for this environment. The worker connects to it.
SKAIL_SIDECAR=<skail-address>
# Base URL of the skail HTTP API for this environment, without /api/v1. The web app uses it to start runs.
SKAIL_BASE_URL=<skail-api-base-url>

# --- this demo ------------------------------------------------------------------------------------
# The worker gets SKAIL_WORKLOAD, WEB_BASE_URL and CITY_HALL_* when it is built: rebuild after changing them
# (scripts/run.sh up does it).
# where the worker reports progress (container name on the batch-billing network)
WEB_BASE_URL=http://batch-billing-web:8080
# host port of the web app
WEB_PORT=8080
# simulated (random outages and some latency) or fake (offline, no outages)
CITY_HALL_PROVIDER=simulated
# chance, in percent, of the simulated city hall being unavailable on a call
CITY_HALL_OUTAGE_PERCENT=10
# optional: link to the skail Monitor shown on the page; read by the web app
#MONITOR_URL=
